# Preserve the path-discovery sentinel, never the research data.
/sample_data/*
!/sample_data/.gitkeep
/benchmark_data/data/
/search_artifacts/
/backup/
.DS_Store
.idea/
.serena/
__pycache__/
*.pyc
.cache/
.mpl_cache/
/tmp/

# Research originals stay in place; SHA inventories and frozen source snapshots
# are versioned under reports/titantpp_scm_cleanup_20261003_v1/ and
# paper/reproducibility/. These rules never remove already tracked evidence.
*.pt
*.pth
*.parquet
*.arrow
*.npz
*.npy
*.pkl
*.pickle
*.tar
*.tar.gz
*.tgz
*.zip
*.synctex.gz
*.aux
*.fdb_latexmk
*.fls
*.bbl
*.blg
*.toc
/out/
node_modules/
.venv/
.pytest_cache/

# Generated/retrieved copies, not the canonical research scripts or reports.
/reports/**/retrieval/
/reports/**/runs/
/reports/**/audit_workspace/
/reports/**/evaluator_sources/
/reports/**/failed_deployment_1/
/reports/**/original/
/reports/**/runtime_cache/
/reports/**/mpl_cache/
/reports/**/app/dist/
/reports/**/app/.openai/
/reports/**/monitor/
/reports/**/observations/
/reports/**/dist/
/reports/**/.data-app-offline/
/reports/**/cache/fontconfig/
*.bundle
