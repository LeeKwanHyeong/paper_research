def test_delete_requires_complete_current_originals(tmp_path, monkeypatch):
    a = allocation(tmp_path)
    monkeypatch.setattr(provider, 'B', tmp_path)
    query = Mock()
    monkeypatch.setattr(provider, 'api', query)
    with pytest.raises(FileNotFoundError):
        provider.teardown(a, 'terminal')
    query.assert_not_called()
    original = tmp_path / 'retrieved/original'
    original.mkdir(parents=True)
    dump(original / 'execution_contract.json', {'scope': 'validation_only'})
    dump(original / 'package_manifest.json', {'files': {'execution_contract.json': provider.sha(original / 'execution_contract.json')}})
    names = ('execution_contract.json', 'package_manifest.json')
    files = {name: provider.sha(original / name) for name in names}
    dump(original / 'retrieval_manifest.json', {'files': files})
    archive = tmp_path / 'retrieved/original.tar.gz'
    with tarfile.open(archive, 'w:gz') as tar:
        for name in (*names, 'retrieval_manifest.json'):
            tar.add(original / name, arcname=name)
    dump(tmp_path / 'retrieved/retrieval_receipt.json', {'pod_id': a['pod_id'], 'remote_root': a['remote_root'],
         'status': 'sha_verified', 'complete_originals': True, 'files': len(files),
         'manifest_files_sha256': provider.canonical(files), 'archive_sha256': provider.sha(archive)})
    assert provider.verify_originals(a)['status'] == 'sha_verified'
    (original / 'execution_contract.json').write_text('changed')
    with pytest.raises(RuntimeError, match='SHA mismatch'):
        provider.teardown(a, 'terminal')
    query.assert_not_called()


def test_archive_rejects_traversal_and_links(tmp_path):
    for name, link in [('../outside.json', False), ('source/link', True)]:
        archive = tmp_path / ('link.tar' if link else 'escape.tar')
        with tarfile.open(archive, 'w') as tar:
            item = tarfile.TarInfo(name)
            if link:
                item.type, item.linkname = tarfile.SYMTYPE, '/outside'
                tar.addfile(item)
            else:
                item.size = 1
                tar.addfile(item, io.BytesIO(b'x'))
        with pytest.raises(RuntimeError, match='Unsafe'):
            manager.extract_verified(archive, tmp_path / 'out')
    assert not (tmp_path / 'out').exists()


