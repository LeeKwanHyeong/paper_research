def test_terminal_waits_for_gpu_and_owned_native_processes():
    snapshot = {'files': {'status.json': {'status': 'failed'}}, 'compute': {'returncode': 0, 'stdout': ''}, 'owned_processes': []}
    assert manager.terminal(snapshot)
    changed = copy.deepcopy(snapshot)
    changed['compute']['stdout'] = '123, 50MiB'
    assert not manager.terminal(changed)
    changed = copy.deepcopy(snapshot)
    changed['owned_processes'] = ['1 2 3 4 python /workspace/campaign/worker/dispatch.py --mode fit --job x']
    assert not manager.terminal(changed)


