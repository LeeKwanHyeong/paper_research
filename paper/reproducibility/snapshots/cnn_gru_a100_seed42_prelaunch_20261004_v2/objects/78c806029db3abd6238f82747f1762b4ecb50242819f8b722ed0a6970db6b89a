def test_pipeline_pins_source_import_path_for_qualification_and_dispatch(tmp_path, monkeypatch):
    c = contract_fixture(tmp_path)
    monkeypatch.setattr(pipeline, 'B', tmp_path)
    monkeypatch.setenv('PYTHONPATH', '/unrelated/inherited/source')
    def native_command(command, **kwargs):
        assert kwargs['env']['PYTHONPATH'] == str(tmp_path / 'source')
        assert kwargs['env']['SOURCE_REVISION'] == c['source']['base_git_revision']
        if str(tmp_path / 'worker/qualify.py') in command:
            dump(tmp_path / 'qualification/receipt.json', {'status': 'passed', 'selected_concurrency': 1,
                'contract_sha256': provider.canonical(c), 'source_files_sha256': c['source']['files_sha256']})
    launch = Mock(side_effect=native_command)
    monkeypatch.setattr(pipeline.subprocess, 'run', launch)
    pipeline.main()
    assert launch.call_count == 2
    assert str(tmp_path / 'worker/qualify.py') in launch.call_args_list[0].args[0]
    assert str(tmp_path / 'worker/dispatch.py') in launch.call_args_list[1].args[0]
    assert (tmp_path / 'training_permit.json').is_file()


def test_hourly_deleted_pod_reuses_original_timestamp(tmp_path):
    a = allocation(tmp_path)
    c = contract_fixture(tmp_path)
    dump(tmp_path / 'current.json', {'pod_id': a['pod_id'], 'bundle': str(tmp_path),
        'contract_sha256': provider.canonical(c), 'source_closure_sha256': c['source']['files_sha256']})
    old_time = time.time() - 3600
    snapshot = {'root': a['remote_root'], 'observed_unix': old_time,
        'files': {'status.json': {'status': 'failed'}}, 'runs': [{'job': job} for job in c['jobs']],
        'owned_processes': [], 'compute': {'returncode': 0, 'stdout': ''}}
    dump(tmp_path / 'retrieved/terminal_snapshot.json', snapshot)
    dump(tmp_path / 'control/cleanup_receipt.json', {'pod_id': a['pod_id'], 'deleted_and_absent': True})
    observer = Mock(side_effect=AssertionError('Never SSH after deletion'))
    assert hourly.run_once(tmp_path, observer_runner=observer) == 0
    observer.assert_not_called()
    receipt = provider.read(tmp_path / 'hourly_monitor/latest.json')
    assert receipt['reused_terminal_evidence'] is True and receipt['fresh_observation'] is False
    assert receipt['observed_unix'] == old_time
