def test_no_inherited_budget_and_actual_rate_clamp():
    authorization = {'approved': True, 'gpu_count': 1, 'automatic_recharge': False,
                     'total_cap_usd': 50, 'retrieval_cleanup_reserve_usd': 20}
    low_rate = provider.budget_limits(authorization, .5, 100)
    assert low_rate['deadline_unix'] == 100 + 48 * 3600
    high_rate = provider.budget_limits(authorization, 2, 100)
    assert high_rate['deadline_unix'] == 100 + 15 * 3600
    for missing in ('total_cap_usd', 'retrieval_cleanup_reserve_usd'):
        changed = dict(authorization)
        del changed[missing]
        with pytest.raises(RuntimeError):
            provider.budget_limits(changed, 2, 100)
    with pytest.raises(RuntimeError):
        provider.budget_limits(dict(authorization, automatic_recharge=True), 2, 100)


def test_real_bundle_style_remote_data_paths_and_optional_exposure(tmp_path):
    c = contract_fixture(tmp_path)
    c['datasets'] = []
    for dataset in sorted(prepare.DATASETS):
        entries = {}
        for key, name in [('data', 'train_validation.parquet'), ('split_manifest', 'split_manifest.json')]:
            local = tmp_path / 'data' / dataset / name
            local.parent.mkdir(parents=True, exist_ok=True)
            local.write_bytes(b'local fixture only')
            entries[key] = {'path': c['hosts']['a100']['root'] + '/data/' + dataset + '/' + name,
                            'sha256': provider.sha(local)}
        c['datasets'].append({'dataset_id': dataset, 'inherited_data_identity': entries})
    checkpoint = tmp_path / 'baselines/intermittent_frozen_5000/selected.pt'
    checkpoint.parent.mkdir(parents=True)
    checkpoint.write_bytes(b'local checkpoint fixture')
    c['baseline_replays'] = {'intermittent_frozen_5000': {'checkpoint': str(checkpoint.relative_to(tmp_path)),
        'checkpoint_sha256': provider.sha(checkpoint)}}
    assert prepare.verify_bundle(tmp_path, c) == c
    c['datasets'][0]['inherited_data_identity']['data']['path'] = '/workspace/foreign/data/input.parquet'
    with pytest.raises(ValueError):
        prepare.verify_bundle(tmp_path, c)


def test_allocation_clamps_to_existing_credit_and_records_unknown_autopay(tmp_path, monkeypatch):
    c = contract_fixture(tmp_path)
    dump(tmp_path / 'user_authorization.json', {'approved': True, 'gpu_count': 1,
        'total_cap_usd': 100, 'retrieval_cleanup_reserve_usd': 20, 'automatic_recharge': False})
    dump(tmp_path / 'preparation_receipt.json', {'status': 'CPU_tests_and_data_admission_passed'})
    dump(tmp_path / 'verification/cpu_data_admission.json', {'status': 'passed'})
    public = tmp_path / '.runpod/ssh/runpodctl-ssh-key.pub'
    public.parent.mkdir(parents=True)
    public.write_text('ssh-ed25519 fixture-key')
    monkeypatch.setattr(allocator, 'B', tmp_path)
    monkeypatch.setattr(allocator, 'verify_bundle', lambda: c)
    monkeypatch.setattr(allocator.Path, 'home', lambda: tmp_path)
    query = Mock(return_value={'clientBalance': 53, 'isAutoPayEnabled': None})
    monkeypatch.setattr(allocator, 'api', query)
    create = Mock(return_value={'podFindAndDeployOnDemand': {'id': 'mock-owned-pod', 'name': tmp_path.name,
        'costPerHr': 1.59, 'createdAt': None, 'gpuCount': 1, 'memoryInGb': 251, 'vcpuCount': 32}})
    monkeypatch.setattr(allocator, 'gql', create)
    a = allocator.allocate(start_manager=False)
    assert a['total_cap_usd'] == 100 and a['authorized_work_cap_usd'] == 80 and a['work_cap_usd'] == 33
    assert 0 < a['deadline_unix'] - a['created_unix'] < 48 * 3600
    assert a['account_autopay_readback'] == 'unknown' and a['provider_stop_guaranteed'] is False
    query.assert_called_once_with('user')
    assert create.call_count == 1
    assert not (tmp_path / 'control/manager_started.json').exists()
    assert provider.read(tmp_path / 'current.json')['pod_id'] == 'mock-owned-pod'
    assert 'fixture-key' not in (tmp_path / 'control/allocation_intent.json').read_text()


