SCHEMA = 'titantpp_cnn_gru_a100_seed42_v1'
ARMS = ('titantpp_cnn_mlp16', 'titantpp_gru54', 'titantpp_cnn_gru54')
BASELINE = 'titantpp_history_mlp_width16'
DATASETS = ('intermittent_frozen_5000', 'yellow_trip_hourly', 'raf_spare_parts')
TRAINING = {'batch_size': 128, 'maximum_epochs': 300, 'minimum_epochs': 40, 'patience': 40,
    'monitor': 'validation_raw_quantity_rmse', 'tie': 'strict_earliest_finite_minimum', 'warm_start': False}
