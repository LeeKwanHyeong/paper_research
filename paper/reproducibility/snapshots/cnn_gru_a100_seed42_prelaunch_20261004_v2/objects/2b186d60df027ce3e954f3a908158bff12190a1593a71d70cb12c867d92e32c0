def require(condition, message):
    if not condition:
        raise ValueError(message)


def read(path):
    return json.loads(Path(path).read_text())


def sha_json(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False,
        separators=(',', ':'), allow_nan=False).encode()).hexdigest()


def sha_file(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for block in iter(lambda: stream.read(1024 ** 2), b''):
            digest.update(block)
    return digest.hexdigest()


def write_json(path, value, exclusive=False):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    encoded = json.dumps(value, sort_keys=True, ensure_ascii=False, indent=2, allow_nan=False) + '\n'
    if exclusive:
        with path.open('x') as stream:
            stream.write(encoded)
    else:
        temporary = path.with_name(path.name + f'.tmp.{os.getpid()}')
        with temporary.open('x') as stream:
            stream.write(encoded)
        os.replace(temporary, path)


def resolve(root, path):
    candidate = Path(path)
    return candidate if candidate.is_absolute() else Path(root) / candidate


def maximum_workers(c):
    return c['limits'].get('max_workers', c['limits'].get('max_concurrent_gpu_jobs_per_host', 3))


def validate_scope(c):
    """Validate the scientific scope without loading source, data or Torch."""
    require(c['schema'] == SCHEMA and c['arms'] == list(ARMS), 'Foreign CNN/GRU campaign')
    require(c['training'] == TRAINING, 'Training/selector contract drift')
    require(c['initialization_policy'] == 'native_historical_baseline_and_common_state_v1',
        'Native historical/common-state initialization policy changed')
    require(c['evaluation_scope'] == 'validation_only' and c['held_out_test_evaluated'] is False,
        'Held-out evaluation is outside this campaign')
    require(set(c['hosts']) == {'a100'}, 'Only the dedicated A100 host is admitted')
    require(len(c['datasets']) == 3 and {d['dataset_id'] for d in c['datasets']} == set(DATASETS),
        'Only Taxi, Intermittent and RAF are admitted')
    expected = {f'{d}__42__{a}': {'id': f'{d}__42__{a}', 'host': 'a100', 'dataset': d, 'seed': 42, 'arm': a}
        for d in DATASETS for a in ARMS}
    jobs = c['jobs']
    require(len(jobs) == 9 and {j['id']: j for j in jobs} == expected, 'Nine seed42 candidate fits required')
    require(set(c['baseline_replays']) == set(DATASETS), 'Three existing MLP16 replays are required')
    require(c.get('reference_baseline', BASELINE) == BASELINE, 'Fixed MLP16 reference changed')
    for dataset, reference in c['baseline_replays'].items():
        require(reference.get('arm', reference.get('baseline_backbone', BASELINE)) == BASELINE
            and reference.get('seed', 42) == 42,
            'Reference checkpoint must be existing seed42 MLP16')
        require(all(type(reference['metrics'][k]) in (int, float) and math.isfinite(reference['metrics'][k])
            for k in ('qty_rmse', 'qty_mae', 'time_nll')), 'Nonfinite baseline metrics')
    limits = c['limits']
    require(maximum_workers(c) == 3 and limits.get('initial_workers', 1) == 1,
        'Concurrency must start at one and cannot exceed three')
    require(limits['automatic_retry'] is False and limits.get('resume', False) is False,
        'Automatic retry/resume is forbidden')
    require(0 < limits['per_condition_seconds'] <= limits['total_wall_seconds'], 'Invalid time ceilings')
    require(0 < limits.get('max_device_memory_fraction', .8) <= .8, 'Memory gate enlarged')
    source = c['source']
    require(len(source['files']) == 117 and len(source['base_git_revision']) == 40
        and source['files_sha256'] == sha_json(source['files']),
        'Source closure digest mismatch')
    require(set(c['dataset_sha256']) == set(DATASETS), 'Data contract digest coverage differs')
    for data in c['datasets']:
        require(sha_json(data) == c['dataset_sha256'][data['dataset_id']], 'Dataset contract changed')
        require(data['loader']['max_seq_len'] in (84, 256) and data['loader']['batch_size'] == 128,
            'Frozen length/batch contract changed')
        require(data['optimizer'] == {'name': 'AdamW', 'lr': .001, 'weight_decay': .01, 'grad_clip': 1.},
            'Frozen optimizer changed')
    return c


def verify_files(c, root):
    root = Path(root).resolve()
    source_root = Path(c['hosts']['a100']['source_root']).resolve()
    for name, digest in c['source']['files'].items():
        path = (source_root / name).resolve()
        require(path.is_relative_to(source_root) and sha_file(path) == digest, 'Source drift ' + name)
    worker = c['worker']
    require(worker['files_sha256'] == sha_json(worker['files']), 'Worker closure digest mismatch')
    for name, digest in worker['files'].items():
        path = (root / name).resolve()
        require(path.is_relative_to(root / 'worker') and sha_file(path) == digest, 'Worker drift ' + name)
    required = {'worker/runtime.py', 'worker/qualify.py', 'worker/dispatch.py', 'worker/diagnostics.py'}
    require(required <= set(worker['files']), 'Executable worker files are not all frozen')
    require(sha_file(root / 'expected_initialization.json') == c['expected_initialization_sha256'],
        'Expected initialization changed')


def authorization(c, root):
    validate_scope(c)
    verify_files(c, root)
    approval, start = read(root / 'approval.json'), read(root / 'start_permit.json')
    require(approval.get('approved') is True and approval['contract_sha256'] == sha_json(c), 'Missing approval')
    require(start['contract_sha256'] == sha_json(c) and start['approval_sha256'] == sha_json(approval),
        'Foreign start permit')
    now = time.time()
    require(start['started_at_unix'] <= now < start['deadline_unix'], 'Campaign deadline exhausted')
    require(0 < start['deadline_unix'] - start['started_at_unix'] <= c['limits']['total_wall_seconds'],
        'Enlarged campaign deadline')
    require(os.environ.get('SOURCE_REVISION') == c['source']['base_git_revision'], 'Source revision missing/drifted')
    return start


def load_engine(c):
    source = Path(c['hosts']['a100']['source_root']).resolve()
    if str(source) not in sys.path:
        sys.path.insert(0, str(source))
    from paper.scripts import run_titantpp_cnn_gru as engine
    require(Path(engine.__file__).resolve().is_relative_to(source), 'CNN/GRU engine imported outside frozen source')
    engine.install_hooks()
    return engine


def runtime_check(c):
    spec = c['hosts']['a100']
    source = Path(spec['source_root']).resolve()
    require(Path(sys.executable).resolve() == Path(spec['python']).resolve(), 'Wrong Python executable')
    require(Path.cwd().resolve() == source, 'Wrong pinned source cwd')
    require(all(os.environ.get(k) == v for k, v in spec['environment'].items()), 'Process environment drift')
    load_engine(c)
    from paper.scripts.quantity_comparison_runtime import configure_runtime, runtime_identity
    from paper.scripts.run_time_quantity_diagnostic import validate_import_origins
    configure_runtime('cuda:0', threads=2)
    actual = runtime_identity('cuda:0')
    validate_import_origins()
    require(actual['gpu']['uuid'] == spec['gpu_uuid'] and actual['gpu']['visible_device_count'] == 1,
        'Wrong GPU or more than one visible device')
    name = actual['gpu'].get('name', '')
    require('A100' in name and 'SXM' in name.upper(), 'Native GPU must be A100 SXM')
    for key, value in spec['runtime_expected'].items():
        require(actual.get(key) == value, 'Runtime drift ' + key)
    require(actual['deterministic_algorithms'] and not actual['deterministic_warn_only'],
        'Strict CUDA determinism is required')
    return actual


def gpu_pids(c):
    result = subprocess.run(['nvidia-smi', '--query-compute-apps=gpu_uuid,pid', '--format=csv,noheader,nounits'],
        check=True, capture_output=True, text=True, timeout=15)
    rows = csv.reader(result.stdout.splitlines())
    return {int(row[1]) for row in rows if row and row[0].strip() == c['hosts']['a100']['gpu_uuid']}


def device_used_bytes(c):
    result = subprocess.run(['nvidia-smi', '--query-gpu=uuid,memory.used,memory.total', '--format=csv,noheader,nounits'],
        check=True, capture_output=True, text=True, timeout=15)
    rows = [row for row in csv.reader(result.stdout.splitlines()) if row and row[0].strip() == c['hosts']['a100']['gpu_uuid']]
    require(len(rows) == 1, 'Ambiguous native GPU memory inventory')
    return {'used': int(rows[0][1]) * 1024 ** 2, 'total': int(rows[0][2]) * 1024 ** 2}


class PulseBudget:
    def __init__(self, root, digest, job, deadline, *, lease=False):
        self.root, self.digest, self.job, self.deadline, self.lease = Path(root), digest, job, deadline, lease
        self.monotonic_deadline = time.monotonic() + max(0, deadline - time.time())
        self.last = 0.

    def __call__(self):
        now = time.time()
        require(now < self.deadline and time.monotonic() < self.monotonic_deadline, 'Absolute time budget exhausted')
        if now - self.last < 2:
            return
        if self.lease:
            lease = read(self.root / 'leases' / (self.job + '.json'))
            require(lease['contract_sha256'] == self.digest and lease['job'] == self.job
                and now < lease['expires_unix'] <= self.deadline, 'Owned supervisor lease expired')
        require(shutil.disk_usage(self.root).free > 5 * 1024 ** 3, 'Free disk below 5 GiB')
        write_json(self.root / 'progress' / (self.job + '.json'), {'job': self.job, 'pid': os.getpid(),
            'updated_unix': now, 'deadline_unix': self.deadline, 'mac_required': False})
        self.last = now


def verify_native_initialization(initial, repeated, reference, diagnostic):
    """Current Mac CPU is provenance; the native baseline must match history."""
    expected = {BASELINE, *ARMS}
    require(set(initial) == set(repeated) == set(diagnostic) == expected,
        'All four initialization identities are required')
    require(initial == repeated, 'Repeated native initialization differs')
    require(initial[BASELINE] == reference['initial_state_sha256'],
        'Historical/native MLP16 initialization mismatch')
    return {'status': 'passed', 'policy': 'native_historical_baseline_and_common_state_v1',
        'native': initial, 'native_independent_repeated': repeated,
        'historical_MLP16_initial_state_sha256': reference['initial_state_sha256'],
        'local_CPU_diagnostic': diagnostic, 'local_CPU_equals_native': initial == diagnostic,
        'local_CPU_role': 'diagnostic provenance only; not a native hash admission gate',
        'native_common_tensors_and_outer_RNG_equal': True}


def verify_fit_initialization(qualification, dataset, initial):
    require(set(initial) == {BASELINE, *ARMS}, 'Fit initialization identity coverage differs')
    require(initial == qualification['initialization'][dataset]['42'], 'Qualified initial tensors changed')
    return True


def verify_training_permit(c, root):
    permit, start = read(root / 'training_permit.json'), read(root / 'start_permit.json')
    receipt = read(root / 'qualification/receipt.json')
    require(permit['contract_sha256'] == sha_json(c) and permit['start_permit_sha256'] == sha_json(start),
        'Foreign training permit')
    require(permit['qualification_sha256'] == sha_file(root / 'qualification/receipt.json'), 'Qualification SHA changed')
    require(receipt['status'] == 'passed' and receipt['contract_sha256'] == sha_json(c)
        and receipt['source_files_sha256'] == c['source']['files_sha256'], 'Native qualification not passed')
    require(receipt['worker_files_sha256'] == c['worker']['files_sha256'], 'Qualified worker changed')
    concurrency = receipt['selected_concurrency']
    require(type(concurrency) is int and concurrency in (1, 3), 'Unqualified concurrency')
    require(receipt['parallel_measurements']['1']['status'] == 'passed', 'Sequential native probe required')
    if concurrency == 3:
        require(receipt['parallel_measurements']['3']['status'] == 'passed', 'Three workers not qualified')
    require(set(receipt['native_checks']) == set(ARMS), 'All three native candidate checks required')
    for arm in ARMS:
        native = receipt['native_checks'][arm]
        require(native['causality']['status'] == 'passed' and set(native['lengths']) == {'256', '84'},
            'Native causality/maximum-length qualification incomplete')
        for length, row in native['lengths'].items():
            repeats = row['repetitions']
            require(row['status'] == 'passed' and row['identical_repetitions'] is True and len(repeats) == 2
                and repeats[0]['fingerprint'] == repeats[1]['fingerprint'], 'Native repeated execution differs')
            require(all(x['batch_size'] == 128 and x['sequence_length'] == int(length)
                and x['actual_joint_gradient_finite'] is True for x in repeats), 'Native full-batch joint-gradient checks incomplete')
    require(set(receipt['baselines']) == set(DATASETS) and all(x['status'] == 'passed'
        and x['full_validation_replay'] is True and x['new_training'] is False
        for x in receipt['baselines'].values()), 'Three frozen MLP16 full-Val replays required')
    return permit


def stop_owned(child):
    if child.poll() is not None:
        return
    require(os.getpgid(child.pid) == child.pid, 'Owned process group changed')
    os.killpg(child.pid, signal.SIGTERM)
    try:
        child.wait(timeout=10)
    except subprocess.TimeoutExpired:
        os.killpg(child.pid, signal.SIGKILL)
        child.wait(timeout=10)


def release_gpu():
    import torch
    gc.collect()
    torch.cuda.empty_cache()


def cli(description, *, modes=None):
    parser = argparse.ArgumentParser(description=description)
    parser.add_argument('--contract', required=True)
    parser.add_argument('--host', choices=('a100',), default='a100')
    if modes:
        parser.add_argument('--mode', required=True, choices=modes)
        parser.add_argument('--job')
        parser.add_argument('--deadline', type=float)
    args = parser.parse_args()
    c = read(args.contract)
    root = Path(c['hosts']['a100']['root']).resolve()
    require(Path(args.contract).resolve() == root / 'execution_contract.json', 'Wrong contract root')
    require(Path(__file__).resolve().parents[1] == root, 'Worker outside admitted bundle')
    authorization(c, root)
    return args, c, root
