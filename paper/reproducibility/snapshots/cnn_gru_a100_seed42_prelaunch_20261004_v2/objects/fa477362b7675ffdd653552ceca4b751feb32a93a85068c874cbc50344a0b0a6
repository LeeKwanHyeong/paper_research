def test_terminal_sha_and_path_escape_rejected(contract, tmp_path):
    job = contract['jobs'][0]
    folder = tmp_path / job['id']
    folder.mkdir()
    (folder / 'metric.json').write_text('{}\n')
    manifest = {'status': 'complete', 'scientific_success': True, 'job': job,
        'contract_sha256': r.sha_json(contract), 'held_out_test_evaluated': False,
        'files': {'metric.json': r.sha_file(folder / 'metric.json')}}
    r.write_json(folder / 'terminal_manifest.json', manifest)
    assert dispatch.verify_terminal(folder, contract, job)['status'] == 'complete'
    (folder / 'metric.json').write_text('changed\n')
    with pytest.raises(ValueError, match='Terminal SHA'):
        dispatch.verify_terminal(folder, contract, job)
    outside = tmp_path / 'outside.json'
    outside.write_text('outside')
    manifest['files'] = {'../outside.json': r.sha_file(outside)}
    r.write_json(folder / 'terminal_manifest.json', manifest)
    with pytest.raises(ValueError, match='Terminal SHA'):
        dispatch.verify_terminal(folder, contract, job)


def test_exposure_reference_is_explicitly_width4_only(tmp_path):
    data = {'dataset_id': 'synthetic'}
    exposure = {'train': [{'epoch': 1, 'batch_order_sha256': 'fixed'}],
        'validation': [{'epoch': 1, 'batch_order_sha256': 'val'}]}
    r.write_json(tmp_path / 'references/width4/synthetic/exposure.json', exposure)
    c = {'reuse': [{'dataset': 'synthetic', 'seed': 42, 'arm': 'titantpp_history_mlp',
        'remote_run': 'references/width4/synthetic', 'file_sha256': {'exposure.json':
            r.sha_file(tmp_path / 'references/width4/synthetic/exposure.json')}}]}
    receipt = dispatch.compare_exposure(c, tmp_path, data, exposure)
    assert receipt['purpose'] == 'batch exposure identity only'
    assert receipt['reference_arm'] == 'titantpp_history_mlp'
    altered = deepcopy(exposure)
    altered['train'][0]['batch_order_sha256'] = 'changed'
    with pytest.raises(ValueError, match='train batch prefix'):
        dispatch.compare_exposure(c, tmp_path, data, altered)


