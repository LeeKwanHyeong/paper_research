def test_causality_rejects_missing_actual_trainer_output(engine, monkeypatch):
    from paper.scripts.count_aware_tpp_backbone import core
    original = core.target_outputs
    def broken(*args, **kwargs):
        result = original(*args, **kwargs)
        result.pop('pred_qty')
        return result
    monkeypatch.setattr(core, 'target_outputs', broken)
    with pytest.raises(ValueError, match='Actual quantity/time outputs missing'):
        qualify.causality_check(engine, r.ARMS[0], lambda: None, device='cpu')


def test_historical_initialization_mismatch_is_fatal_and_CPU_is_only_diagnostic():
    initial = {arm: arm + '_native' for arm in (r.BASELINE, *r.ARMS)}
    diagnostic = {arm: arm + '_other_CPU' for arm in initial}
    reference = {'initial_state_sha256': initial[r.BASELINE]}
    proof = r.verify_native_initialization(initial, deepcopy(initial), reference, diagnostic)
    assert proof['status'] == 'passed' and proof['local_CPU_equals_native'] is False
    wrong_history = {'initial_state_sha256': 'different_historical_baseline'}
    with pytest.raises(ValueError, match='Historical/native MLP16'):
        r.verify_native_initialization(initial, deepcopy(initial), wrong_history, diagnostic)
    repeated = deepcopy(initial)
    repeated[r.ARMS[1]] += '_changed'
    with pytest.raises(ValueError, match='Repeated native'):
        r.verify_native_initialization(initial, repeated, reference, diagnostic)


def test_fit_rejects_any_modified_native_qualified_candidate():
    initial = {arm: arm + '_native' for arm in (r.BASELINE, *r.ARMS)}
    qualification = {'initialization': {'synthetic': {'42': deepcopy(initial)}}}
    assert r.verify_fit_initialization(qualification, 'synthetic', initial)
    initial[r.ARMS[2]] += '_changed'
    with pytest.raises(ValueError, match='Qualified initial tensors changed'):
        r.verify_fit_initialization(qualification, 'synthetic', initial)
