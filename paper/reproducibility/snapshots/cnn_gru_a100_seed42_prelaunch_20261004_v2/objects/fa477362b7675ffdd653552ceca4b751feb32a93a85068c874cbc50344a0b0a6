@pytest.mark.parametrize('mutation', ['test', 'instacart', 'baseline_fit', 'second_seed', 'duplicate',
    'warm_start', 'batch', 'selector', 'retry', 'resume', 'four_workers', 'memory', 'optimizer'])
def test_scope_and_reproducibility_drift_rejected(contract, mutation):
    if mutation == 'test':
        contract['held_out_test_evaluated'] = True
    elif mutation == 'instacart':
        contract['datasets'][0]['dataset_id'] = 'insta_market_basket'
    elif mutation == 'baseline_fit':
        contract['jobs'][0]['arm'] = r.BASELINE
    elif mutation == 'second_seed':
