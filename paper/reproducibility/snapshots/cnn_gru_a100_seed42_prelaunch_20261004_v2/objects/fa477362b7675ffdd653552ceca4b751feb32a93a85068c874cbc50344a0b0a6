    elif mutation == 'duplicate':
        contract['jobs'][-1] = deepcopy(contract['jobs'][0])
    elif mutation == 'warm_start':
        contract['training']['warm_start'] = True
    elif mutation == 'batch':
        contract['training']['batch_size'] = 64
    elif mutation == 'selector':
        contract['training']['monitor'] = 'val_time_nll'
    elif mutation == 'retry':
        contract['limits']['automatic_retry'] = True
    elif mutation == 'resume':
        contract['limits']['resume'] = True
    elif mutation == 'four_workers':
        contract['limits']['max_workers'] = 4
    elif mutation == 'memory':
        contract['limits']['max_device_memory_fraction'] = .95
    else:
        contract['datasets'][0]['optimizer']['lr'] = .01
        d = contract['datasets'][0]
        contract['dataset_sha256'][d['dataset_id']] = r.sha_json(d)
    with pytest.raises(ValueError):
        r.validate_scope(contract)


def test_source_and_worker_freeze_rejects_mutation(contract, tmp_path):
    root = tmp_path
    source = root / 'source'
    source.mkdir()
    (source / 'engine.py').write_text('frozen source\n')
    contract['hosts']['a100']['source_root'] = str(source)
    contract['source']['files'] = {'engine.py': r.sha_file(source / 'engine.py')}
    contract['source']['files_sha256'] = r.sha_json(contract['source']['files'])
    worker = root / 'worker'
    worker.mkdir()
    for name in ('runtime.py', 'dispatch.py', 'qualify.py', 'diagnostics.py'):
        (worker / name).write_text('# frozen\n')
    contract['worker']['files'] = {str(p.relative_to(root)): r.sha_file(p) for p in worker.glob('*.py')}
    contract['worker']['files_sha256'] = r.sha_json(contract['worker']['files'])
    r.write_json(root / 'expected_initialization.json', {'synthetic': True})
    contract['expected_initialization_sha256'] = r.sha_file(root / 'expected_initialization.json')
    r.verify_files(contract, root)
    (worker / 'qualify.py').write_text('# changed\n')
    with pytest.raises(ValueError, match='Worker drift'):
        r.verify_files(contract, root)
    (worker / 'qualify.py').write_text('# frozen\n')
    (source / 'engine.py').write_text('changed source\n')
    with pytest.raises(ValueError, match='Source drift'):
        r.verify_files(contract, root)


def test_three_requires_passed_native_measurements_and_speedup():
    one = {'status': 'passed', 'measured_work_seconds': 100.}
    assert qualify.select_concurrency({'1': one, '3': {'status': 'failed'}}) == 1
    assert qualify.select_concurrency({'1': one, '3': {'status': 'passed', 'measured_work_seconds': 97.}}) == 1
    assert qualify.select_concurrency({'1': one, '3': {'status': 'passed', 'measured_work_seconds': 90.}}) == 3
    with pytest.raises(ValueError, match='Sequential'):
        qualify.select_concurrency({'1': {'status': 'failed'}})


