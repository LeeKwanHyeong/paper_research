"""Read only validation records and process evidence, with no provider credentials."""
import argparse
import hashlib
import json
import subprocess
import time
from pathlib import Path


def snapshot(root):
    root = Path(root)
    contract = json.loads((root / 'execution_contract.json').read_text())
    assert contract['evaluation_scope'] == 'validation_only' and contract['held_out_test_evaluated'] is False
    out = {'host': 'a100', 'observed_unix': time.time(), 'root': str(root), 'files': {}, 'file_sha256': {}, 'runs': []}

    def read(p):
        if not p.exists():
            return None
        raw = p.read_bytes()
        assert len(raw) < 20 * 1024 * 1024
        out['file_sha256'][str(p.relative_to(root))] = hashlib.sha256(raw).hexdigest()
        return json.loads(raw)

    for name in ('status.json', 'failure.json', 'start_permit.json', 'pipeline_failure.json', 'qualification/receipt.json', 'pipeline.claim'):
        out['files'][name] = read(root / name)
    for job in contract['jobs']:
        assert job['host'] == 'a100' and job['seed'] == 42
        p = root / 'run' / job['id']
        row = {'job': job, 'status': read(p / 'status.json'), 'two_epoch_cost': read(p / 'two_epoch_cost_receipt.json')}
        run = p / 'runs' / job['arm'] / contract['quantity_variants'][job['arm']] / ('seed_' + str(job['seed']))
        for key, name in [('history', 'history.json'), ('timing', 'epoch_timing.json'), ('endpoints', 'endpoint_replays.json')]:
            row[key] = read(run / name)
        row['checkpoint_receipt'] = read(run / 'server_checkpoint_receipt.json')
        checkpoint = run / 'last_epoch_state.pt'
        row['last_checkpoint_bytes'] = checkpoint.stat().st_size if checkpoint.exists() else None
        manifest = read(p / 'terminal_manifest.json')
        row['terminal_manifest'] = manifest
        if manifest:
            checks = {}
            for name, digest in manifest['files'].items():
                relative = Path(name)
                assert not relative.is_absolute() and '..' not in relative.parts
                if name.endswith('.json'):
                    assert not relative.name.startswith(('test_', 'held_out_')), 'Held-out artifact stays locked'
                    f = p / name
                    checks[name] = f.is_file() and hashlib.sha256(f.read_bytes()).hexdigest() == digest
            row['small_record_SHA_passed'] = bool(checks) and all(checks.values())
            row['small_record_checks'] = checks
        out['runs'].append(row)
    for key, command in [('compute', ['nvidia-smi', '--query-compute-apps=pid,used_memory', '--format=csv,noheader']),
                         ('gpu', ['nvidia-smi', '--query-gpu=uuid,utilization.gpu,memory.used', '--format=csv,noheader'])]:
        result = subprocess.run(command, capture_output=True, text=True, timeout=15)
        out[key] = {'returncode': result.returncode, 'stdout': result.stdout, 'stderr': result.stderr}
    result = subprocess.run(['ps', '-eo', 'pid,ppid,pgid,etimes,args'], capture_output=True, text=True, timeout=15)
    out['owned_processes'] = [line for line in result.stdout.splitlines() if str(root) in line]
    out['qualification_files'] = [str(p.relative_to(root)) for p in (root / 'qualification').rglob('*.json')]
    for name in ('bootstrap.log', 'qualification.log', 'pipeline.log'):
        p = root / name
        if p.exists():
            out[name] = p.read_text(errors='replace')[-1800:]
    return out


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', required=True)
    args = parser.parse_args()
    print(json.dumps(snapshot(args.root), allow_nan=False))
