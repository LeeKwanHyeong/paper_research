"""One read-only predeployment inventory per server; never imports CUDA."""
import concurrent.futures
import hashlib
import json
from pathlib import Path
import subprocess

B = Path(__file__).resolve().parents[1]
old = json.loads((B.parent / 'titantpp_history_width16_dual_20261003_v1/execution_contract.json').read_text())
binding = json.loads((B / 'verification/baseline_binding.json').read_text())
script = '''import datetime,hashlib,json,pathlib,shutil,subprocess
root=pathlib.Path(ROOT)
def sha(p):
 h=hashlib.sha256()
 with pathlib.Path(p).open('rb') as f:
  for block in iter(lambda:f.read(1024*1024),b''):h.update(block)
 return h.hexdigest()
c=json.loads((root/'execution_contract.json').read_text())
actual=hashlib.sha256(json.dumps(c,sort_keys=True,ensure_ascii=False,separators=(',',':'),allow_nan=False).encode()).hexdigest()
assert actual=='7b0681473fcde54a16b564821448490a5d6a5561c9d51b60903c9b7f2981e548'
checks=[]
for row in ROWS:
 assert sha(row['checkpoint'])==row['checkpoint_sha256'],'baseline checkpoint drift'
 assert sha(row['exposure']['remote_path'])==row['exposure']['sha256'],'baseline exposure drift'
 checks.append({'dataset':row['dataset'],'seed':row['seed'],'checkpoint_sha_passed':True,'exposure_sha_passed':True})
gpu=subprocess.run(['nvidia-smi','--query-compute-apps=gpu_uuid,pid','--format=csv,noheader,nounits'],capture_output=True,text=True,check=True,timeout=15)
status=json.loads((root/'status.json').read_text())
new=root.parent/NEWNAME
assert not new.exists(),'new campaign target already exists'
assert shutil.disk_usage(root).free>5*1024**3
print(json.dumps({'status':'passed','observed_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'host':HOST,
 'parent_status':status,'parent_failure_exists':(root/'failure.json').exists(),'baseline_checks':checks,
 'new_root_absent':True,'free_bytes':shutil.disk_usage(root).free,'gpu_processes':gpu.stdout.strip()}))
'''

def one(host):
    text = script.replace('ROOT', repr(old['hosts'][host]['root'])).replace('ROWS', repr([r for r in binding['rows'] if r['host'] == host])).replace('HOST', repr(host)).replace('NEWNAME', repr(f'titantpp_history_width16_replication_{host}_20261003_v1'))
    result = subprocess.run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', host, 'python3 -'],
        input=text, text=True, capture_output=True, timeout=90)
    out = json.loads(result.stdout) if result.returncode == 0 else {'status': 'failed', 'host': host, 'stderr': result.stderr}
    with (B / 'verification' / f'preflight_{host}.json').open('x') as f:
        json.dump(out, f, indent=2, ensure_ascii=False)
    return out

with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
    results = list(pool.map(one, ('5080', '5090')))
print(json.dumps(results, ensure_ascii=False))
assert all(r['status'] == 'passed' and not r['parent_failure_exists'] for r in results)
