def sha_json(value):
    return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def sha_file(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()

def require(condition,message):
    if not condition:raise RuntimeError(message)

def write_json(path,value,exclusive=False):
    path=Path(path);path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('x' if exclusive else 'w') as stream:json.dump(value,stream)

def load_functions():
    # Execute the production function bodies, omitting imports of the ML stack.
    tree=ast.parse(RUNNER.read_text(),filename=str(RUNNER))
    names={'validate','qualify','run_fit','verify_training_permit'}
    constants={'SCHEMA','SEEDS','TRAINING_PERMIT_SCHEMA','ASSIGNMENTS','ARMS'}
    definitions=[node for node in tree.body if
        (isinstance(node,ast.FunctionDef) and node.name in names) or
        (isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id in constants for t in node.targets))]
    ns={'Path':Path,'require':require,'read':lambda p:json.loads(Path(p).read_text()),
        'common':SimpleNamespace(sha_json=sha_json,sha_file=sha_file,write_json=write_json),
        'ROOT':RUNNER.parents[2],'SCHEMA':'titantpp_history_width16_replication_20261003_v1',
        'TRAINING_PERMIT_SCHEMA':'titantpp_history_width16_replication_training_permit_v1',
        'ARMS':(ARM,),'ARM':ARM,'SEEDS':(52,62),'ASSIGNMENTS':ASSIGNMENTS,
        'json':json,'time':time,'math':math,'statistics':statistics,'os':SimpleNamespace(getpid=lambda:123),
        'gc':SimpleNamespace(collect=lambda:None)}
    exec(compile(ast.Module(body=definitions,type_ignores=[]),str(RUNNER),'exec'),ns)
    return ns


def contract(root):
    datasets=[{'dataset_id':d,'loader':{'max_seq_len':8},'quantity_boundaries_all_train_rows':[1,2,3,4]}
        for ds in ASSIGNMENTS.values() for d in ds]
    return {'schema':'titantpp_history_width16_replication_20261003_v1','arms':[ARM],
        'training':{'batch_size':128,'maximum_epochs':300,'minimum_epochs':40,'patience':40,
            'monitor':'validation_raw_quantity_rmse','tie':'strict_earliest_finite_minimum','warm_start':False},
        'limits':{'total_wall_seconds':168*3600,'per_condition_seconds':36*3600,'workers_per_host':1,'automatic_retry':False},
        'jobs':[{'id':f'{d}__{s}__{ARM}','host':h,'dataset':d,'seed':s,'arm':ARM}
            for h,ds in ASSIGNMENTS.items() for d in ds for s in (52,62)],
        'reuse':[{'host':h,'dataset':d,'seed':s,'arm':'titantpp_history_mlp'}
            for h,ds in ASSIGNMENTS.items() for d in ds for s in (52,62)],
        'baseline_replays':{d:{str(s):{} for s in (52,62)} for ds in ASSIGNMENTS.values() for d in ds},
        'evaluation_scope':'validation_only','held_out_test_evaluated':False,
        'source':{'files':{},'files_sha256':sha_json({})},'datasets':datasets,
        'dataset_sha256':{d['dataset_id']:sha_json(d) for d in datasets},
        'hosts':{h:{'root':str(root/h)} for h in ASSIGNMENTS},
        'diagnostic':{'train_sampling':{'fixed':'unchanged'}}}

