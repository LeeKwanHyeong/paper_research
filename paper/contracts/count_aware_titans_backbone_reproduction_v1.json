{
  "contract_id": "count_aware_titans_backbone_reproduction_v1",
  "frozen_at": "2026-08-26",
  "paper_source": {
    "title": "Titans: Learning to Memorize at Test Time",
    "arxiv": "https://arxiv.org/abs/2501.00663",
    "mechanism_equations": [11, 12, 13, 14, 15],
    "mac_equations": [21, 22, 23, 24, 25]
  },
  "variants": {
    "B0": {
      "name": "Current Hard-LMM",
      "canonical_component": "Hard Local Memory Matcher",
      "implementation": "HardLocalMemoryMatcher",
      "legacy_identifiers": ["LMM", "static_hard_lmm"],
      "memory_type": "static_learned_prototype_bank",
      "test_time_weight_update": false,
      "faithful_titans_ltm": false,
      "publication_role": "current_t0_control"
    },
    "B1": {
      "name": "Faithful Titans-MAC",
      "canonical_component": "Titans Neural Long-term Memory",
      "memory_type": "deep_neural_associative_memory",
      "test_time_weight_update": true,
      "faithful_titans_ltm": true,
      "incorporation": "memory_as_context",
      "publication_role": "original_titans_mechanism_control"
    },
    "B2": {
      "name": "TPP-specific Gated Memory",
      "canonical_component": "Causal Gated Neural Memory",
      "memory_type": "event_domain_gated_dynamic_memory",
      "test_time_weight_update": true,
      "faithful_titans_ltm": false,
      "incorporation": "task_specific_gated_branch",
      "publication_role": "proposed_backbone_candidate"
    }
  },
  "b1_mechanism": {
    "key": "k_t = l2_norm(silu(W_K x_t))",
    "value": "v_t = silu(W_V x_t)",
    "query": "q_t = l2_norm(silu(W_Q x_t))",
    "associative_loss": "squared_l2(M_{t-1}(k_t), v_t)",
    "surprise": "gradient_of_associative_loss_wrt_memory_parameters",
    "momentum": "S_t = eta_t * S_{t-1} - theta_t * surprise_t",
    "forgetting": "M_t = (1 - alpha_t) * M_{t-1} + S_t",
    "retrieval": "M_{t-1}(q_t)",
    "memory_network": {
      "type": "mlp",
      "depth": 2,
      "activation": "silu",
      "hidden_expansion": 2
    },
    "rates": "token_dependent_alpha_theta_eta"
  },
  "b1_mac": {
    "segment_size": 16,
    "persistent_memory_tokens": 16,
    "read_state": "segment_start_M_previous",
    "attention_context_order": [
      "persistent_memory",
      "retrieved_long_term_memory",
      "current_observed_segment"
    ],
    "write_source": "valid_attention_outputs_for_current_observed_segment",
    "final_output": "attention_output_gated_with_post_write_memory_read"
  },
  "causal_event_protocol": [
    "Build each segment from observed history events only.",
    "Read the segment-start memory before any event in that segment is written.",
    "Produce hidden states that predict next-event targets before memory write.",
    "Write only valid current-segment attention outputs after prediction states exist.",
    "Never use next-event time or quantity targets in key, value, rate, or memory updates."
  ],
  "state_scope": {
    "default": "independent_input_sequence",
    "streaming": "explicit_state_in_explicit_state_out",
    "series_boundary": "mandatory_reset_to_meta_learned_initial_state",
    "batch_rows": "independent_memory_and_momentum_state",
    "validation_and_test": "no_state_sharing_between_series",
    "persistent_memory": "outer_loop_parameter_fixed_during_validation_and_test",
    "long_term_memory": "online_state_updated_from_observed_events_during_validation_and_test"
  },
  "matched_t0_boundary": {
    "history_features": ["log1p_delta_t", "log1p_raw_quantity"],
    "quantity_loss": "mse_on_log1p_quantity",
    "quantity_head": "shared_count_aware_quantity_head",
    "time_head": "legacy_clamped_rmtpp",
    "checkpoint_selection": "minimum_validation_joint_objective",
    "held_out_test": "locked"
  },
  "implementation_order": ["B0", "B1"],
  "b2_status": "contract_only_until_B1_passes_all_contract_tests",
  "performance_gate": "blocked_until_contract_tests_pass"
}
