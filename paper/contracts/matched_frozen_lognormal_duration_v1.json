{
  "contract_id": "matched_frozen_lognormal_duration_v1",
  "schema_version": 1,
  "purpose": "Fit the same isolated normalized heteroscedastic log-normal duration head on frozen A, B, RMTPP, and THP representations before making comparative Time NLL claims.",
  "scope": {
    "datasets": [
      "intermittent_frozen_5000",
      "yellow_trip_hourly",
      "insta_market_basket"
    ],
    "model_roles": [
      "A",
      "B",
      "rmtpp",
      "thp"
    ],
    "input_splits": [
      "train",
      "validation"
    ],
    "optimization_split": "train",
    "selection_split": "validation",
    "evaluation_scope": "validation_only",
    "held_out_test": false,
    "seed": 42,
    "additional_seeds": false
  },
  "comparison_policy": {
    "same_duration_head_for_every_role": true,
    "same_optimization_for_every_new_fit": true,
    "B_result_policy": "reuse the audited c04d32b full result without refitting",
    "source_checkpoint_selector_note": "A, RMTPP, and THP use their historical joint-objective checkpoints; B uses its predeclared raw-RMSE checkpoint. Time NLL therefore compares frozen representation information at those paper quantity checkpoints.",
    "cross_dataset_nll_aggregation": false,
    "legacy_nll_comparison": false,
    "four_way_complete_requires_all_twelve_rows": true
  },
  "model_roles": {
    "A": {
      "label": "original Hard-LMM T0",
      "backbone": "titantpp",
      "execution": "fit_new",
      "source_checkpoint_selection": "best_validation_joint_objective"
    },
    "B": {
      "label": "raw-RMSE-selected Hard-LMM T0",
      "backbone": "titantpp",
      "execution": "reuse_c04d32b",
      "source_checkpoint_selection": "best_validation_raw_quantity_rmse"
    },
    "rmtpp": {
      "label": "RMTPP",
      "backbone": "rmtpp",
      "execution": "fit_new_when_available",
      "source_checkpoint_selection": "best_validation_joint_objective"
    },
    "thp": {
      "label": "THP",
      "backbone": "thp",
      "execution": "fit_new",
      "source_checkpoint_selection": "best_validation_joint_objective"
    }
  },
  "time_head": {
    "location": "mu(h) = v_t(h) + b_t",
    "scale": "sigma(h) = 0.001 + softplus(time_scale_weight(h) + w_raw)",
    "time_scale": "exact train-target median",
    "location_initialization": "zero weight and float32 parameter initialized from the exact train mean of log(dt / train median)",
    "scale_initialization": "zero weight and float32 parameter initialized from the exact train standard deviation of log(dt / train median)",
    "original_unit_jacobian": true,
    "duration_clamp": false,
    "calculation_dtype": "float64",
    "trainable_parameter_names": [
      "v_t.weight",
      "b_t",
      "w_raw",
      "time_scale_weight.weight"
    ],
    "expected_trainable_parameter_count": 130
  },
  "parameter_boundary": {
    "frozen_state": [
      "source encoder",
      "source memory when present",
      "source quantity head",
      "all source buffers and parameters outside the four named duration-head tensors"
    ],
    "non_time_state_copy": "bitwise copy from each pinned source checkpoint",
    "encoder_mode": "eval",
    "hidden_state_gradient": "detached",
    "feature_strategy": "encode each admitted history once and cache float32 hidden states on CPU",
    "dropout_during_cache": false,
    "target_quantity_masked_before_encoding": true,
    "target_memory_write_masked": true
  },
  "observation_likelihood": {
    "uncensored": "log f(dt | h) in the original time unit",
    "right_censored": "log S(threshold | h)",
    "reduction": "arithmetic mean over admitted target events",
    "instacart_top_code_source": {
      "provider_release": "https://tech.instacart.com/3-million-instacart-orders-open-sourced-d40d29ead6f2",
      "provider_data_dictionary": "https://gist.github.com/jeremystan/c3b39d947d9b88b3ccff3147dbcf6c6b#file-data_description-md-L8",
      "field": "days_since_prior_order",
      "semantics": "provider-capped at 30 days",
      "local_preprocessing_adds_cap": false
    }
  },
  "optimization": {
    "shared_across_all_datasets": true,
    "seed": 42,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "encoder_batch_size": 128,
    "cached_state_batch_size": 8192,
    "gradient_clip": 1.0,
    "epochs": 100,
    "minimum_epochs": 20,
    "early_stopping_patience": 20,
    "training_objective": "mean negative censor-aware normalized log-normal duration log likelihood",
    "scheduler": null,
    "dataset_specific_hyperparameters": false
  },
  "checkpoint_selection": {
    "candidate_epochs": "0 through the last completed refit epoch",
    "epoch_zero": "train-only log-moment initialization nested in the candidate: exact mean and standard deviation of log(dt / train median), with both conditional weight tensors zero",
    "epoch_zero_censor_note": "The Instacart top-code enters the initialization moments at its observed code 30; every optimization and validation likelihood term for that code is survival-based",
    "monitor": "validation_proper_time_nll",
    "rule": "earliest strict finite minimum",
    "fallback": "epoch 0",
    "other_metrics_in_selector": false,
    "resume": "model, optimizer, contiguous history, current state, best state, source identity, cache identity, censor identity, and selection identity must restore exactly"
  },
  "identity_and_stability": {
    "source_checkpoint_file_sha256_required": true,
    "source_model_state_sha256_required": true,
    "train_and_validation_target_identity_required": true,
    "target_dt_sha256_required": true,
    "censor_mask_sha256_required": true,
    "non_time_state_sha256_must_match_source": true,
    "quantity_prediction_required": "bitwise identical on every cached validation target",
    "quantity_mae_and_rmse_required": "calculation-identical to each pinned source checkpoint",
    "proper_time_nll_replay_absolute_tolerance": 1e-06,
    "reported_quantity_metric_absolute_tolerance": 1e-06,
    "reported_quantity_metric_relative_tolerance": 1e-05,
    "finite_train_loss": true,
    "finite_validation_loss": true,
    "finite_gradient": true,
    "finite_model_and_optimizer_state": true,
    "selected_checkpoint_replay_required": true,
    "density_integrates_to_one_required": true,
    "survival_monotonic_required": true,
    "median_survival_equals_one_half_required": true
  },
  "B_reuse": {
    "required_source_revision": "c04d32b0ba80a463097d91c4128ea966f22ec660",
