{
  "schema_version": 1,
  "contract_id": "aligned_frozen_lognormal_duration_v1",
  "purpose": "Fit the same isolated K=1 heteroscedastic log-normal duration head on frozen A and B representations using the observation likelihood selected before results are viewed.",
  "scope": {
    "datasets": [
      "intermittent_frozen_5000",
      "yellow_trip_hourly",
      "insta_market_basket"
    ],
    "model_roles": [
      "A",
      "B"
    ],
    "input_splits": [
      "train",
      "validation"
    ],
    "optimization_split": "train",
    "selection_split": "validation",
    "evaluation_scope": "validation_only",
    "held_out_test": false,
    "seed": 42,
    "additional_seeds": false,
    "quantity_predictions_may_change": false
  },
  "model_roles": {
    "A": {
      "label": "original Hard-LMM T0",
      "backbone": "titantpp",
      "source_checkpoint_selection": "best_validation_joint_objective"
    },
    "B": {
      "label": "raw-RMSE-selected Hard-LMM T0",
      "backbone": "titantpp",
      "source_checkpoint_selection": "best_validation_raw_quantity_rmse"
    }
  },
  "time_head": {
    "location": "mu(h) = v_t(h) + b_t",
    "scale": "sigma(h) = 0.001 + softplus(time_scale_weight(h) + w_raw)",
    "time_scale": "exact train-target median",
    "location_initialization": "zero weight and float32 parameter initialized from the exact train mean of log(dt / train median)",
    "scale_initialization": "zero weight and float32 parameter initialized from the exact train standard deviation of log(dt / train median)",
    "original_unit_jacobian": true,
    "duration_clamp": false,
    "calculation_dtype": "float64",
    "trainable_parameter_names": [
      "v_t.weight",
      "b_t",
      "w_raw",
      "time_scale_weight.weight"
    ],
    "expected_trainable_parameter_count": 130
  },
  "parameter_boundary": {
    "frozen_state": [
      "source encoder",
      "source memory when present",
      "source quantity head",
      "all source buffers and parameters outside the four named duration-head tensors"
    ],
    "non_time_state_copy": "bitwise copy from each pinned source checkpoint",
    "encoder_mode": "eval",
    "hidden_state_gradient": "detached",
    "feature_strategy": "encode each admitted history once and cache float32 hidden states on CPU",
    "dropout_during_cache": false,
    "target_quantity_masked_before_encoding": true,
    "target_memory_write_masked": true
  },
  "observation_likelihood": {
    "common_latent_family": "K=1 heteroscedastic log-normal duration distribution",
    "calculation_dtype": "float64",
    "probability_clamp": null,
    "loss_cap": null,
    "reduction": "arithmetic mean over admitted target events",
    "dataset_specific_trainable_parameters": false,
    "cross_dataset_nll_aggregation": false,
    "continuous_secondary_metric": "same selected checkpoint evaluated as original-unit log-normal density; Instacart code 30 uses S(30)"
  },
  "optimization": {
    "shared_across_all_datasets": true,
    "seed": 42,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "encoder_batch_size": 128,
    "cached_state_batch_size": 8192,
    "gradient_clip": 1.0,
    "epochs": 100,
    "minimum_epochs": 20,
    "early_stopping_patience": 20,
    "training_objective": "mean negative dataset observation log likelihood defined by observation_contract",
    "scheduler": null,
    "dataset_specific_hyperparameters": false
  },
  "checkpoint_selection": {
    "candidate_epochs": "0 through the last completed refit epoch",
    "monitor": "validation proper observation NLL from the dataset observation_contract",
    "rule": "earliest strict finite minimum",
    "fallback": "epoch 0",
    "other_metrics_in_selector": false,
    "resume": "model, optimizer, history, best state, source and cache identities, and the complete observation likelihood contract restore exactly"
  },
  "cache_policy": {
    "mode": "fresh contract-bound A/B caches",
    "reuse_previous_contract_cache": false,
    "reason": "cache identity includes contract id and SHA; fresh extraction prevents cross-objective identity drift",
    "held_out_materialization": false
  },
  "comparison_policy": {
    "same_time_head_architecture_for_A_and_B": true,
    "same_initialization_optimizer_batch_order_and_epoch_budget": true,
    "same_calibration_source_revision_for_all_rows": true,
    "maximum_prior_B_continuous_replay_absolute_drift": 1e-06,
    "prior_B_reference": "the previous continuous-selected K=1 B checkpoint replayed with the same new dataset observation likelihood",
    "legacy_time_nll_comparison": false,
    "continuous_and_integer_nll_direct_subtraction": false,
    "cross_dataset_nll_aggregation": false
  },
  "acceptance": {
    "minimum_aligned_B_improvement_over_prior_B_primary_nll": 0.005,
    "minimum_aligned_B_improvement_scope": "datasets using positive_integer_round_clamp_lognormal only",
    "maximum_continuous_objective_replay_worsening": 1e-06,
    "maximum_aligned_B_minus_aligned_A_primary_nll": 0.01,
    "quantity_guardrail": "source and aligned predictions plus MAE/RMSE are bitwise/calculation identical per role",
    "decision": "stop before an adapter only when every dataset passes all applicable gates",
    "held_out_claim": false
  },
