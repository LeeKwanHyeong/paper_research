{
  "schema_version": 1,
  "contract_id": "aligned_causal_duration_scale_adapter_v1",
  "purpose": "Test whether causal observed-duration values improve the aligned frozen-B scale under the same normalized observation objective and selector, without changing quantity or time median.",
  "candidate": {
    "name": "aligned_B_frozen_causal_log_duration_scale_adapter",
    "single_hypothesis": true,
    "source_contract_id": "aligned_frozen_lognormal_duration_v1",
    "source_contract_sha256": "677cc3af91d84dfea8e3b4e71b38697fb467059f680678f0b8370a50f2366f16",
    "source_revision": "8213dbcdace2b62425236af15aa28f5b57f7b958",
    "architecture": "single-layer causal GRU8 over active observed log1p durations with zero-initialized bounded scale residual",
    "backbone_change": false,
    "quantity_path_change": false,
    "location_change": false,
    "scale_only": true
  },
  "scope": {
    "datasets": [
      "intermittent_frozen_5000",
      "yellow_trip_hourly",
      "insta_market_basket"
    ],
    "input_splits": [
      "train",
      "validation"
    ],
    "optimization_split": "train",
    "selection_split": "validation",
    "evaluation_scope": "validation_only",
    "held_out_test": false,
    "seed": 42,
    "additional_seeds": false,
    "quantity_predictions_may_change": false,
    "time_median_may_change": false
  },
  "frozen_source": {
    "checkpoint_type": "selected_frozen_lognormal_duration",
    "source_model_role": "B",
    "all_model_parameters_trainable": false,
    "model_mode": "eval",
    "state_digest_must_remain_unchanged": true,
    "feature_cache": "reuse exact aligned-B e1 train and validation cache"
  },
  "adapter": {
    "class_name": "CausalLogDurationAdapter",
    "input_feature": "(log1p(observed_dt)-train_history_log1p_mean)/train_history_log1p_std",
    "input_source": "active context observed durations only",
    "appended_target_excluded": true,
    "marks_excluded": true,
    "quantities_excluded": true,
    "B_hidden_excluded": true,
    "recurrent_cell": "torch.nn.GRU",
    "input_size": 1,
    "hidden_size": 8,
    "num_layers": 1,
    "bidirectional": false,
    "dropout": 0.0,
    "output": "bounded_log_scale_residual",
    "output_projection_initialization": "exact zeros",
    "scale_formula": "sigma_candidate = sigma_B + (sigma_B - sigma_floor) * expm1(log(10) * tanh(raw_delta / log(10)))",
    "location_formula": "mu_candidate = mu_B exactly",
    "expected_trainable_parameter_count": 273,
    "maximum_scale_ratio": 10.0,
    "minimum_scale_ratio": 0.1,
    "max_absolute_log_scale_residual": 2.302585092994046,
    "sigma_floor": 0.001,
    "equivalent_scale_formula": "sigma_floor + (sigma_B - sigma_floor) * exp(bounded_log_scale_residual)"
  },
  "controls": {
    "history_free_global_scale": {
      "role": "bias-only attribution control, not a second architecture candidate",
      "trainable_parameter_count": 1,
      "input_history": false,
      "initialization": "zero",
      "scale_formula": "sigma_control = sigma_B + (sigma_B - sigma_floor) * expm1(log(10) * tanh(raw_bias / log(10)))",
      "selection_and_optimizer": "identical to candidate",
      "minimum_scale_ratio": 0.1,
      "maximum_scale_ratio": 10.0,
      "sigma_floor": 0.001
    },
    "same_capacity_length_only": {
      "role": "duration-value attribution control",
      "architecture": "same GRU8 and scale projection as candidate",
      "trainable_parameter_count": 273,
      "active_token_value": "exp(train_history_log1p_mean)-1 so normalized adapter input is exactly zero",
      "same_lengths_masks_initial_state_optimizer_batch_order": true
    }
  },
  "observation_likelihood": {
    "primary_by_dataset": "exact dataset observation_contract copied from aligned_frozen_lognormal_duration_v1",
    "calculation_dtype": "float64",
    "reduction": "arithmetic mean over admitted target events",
    "secondary_metric": "continuous original-unit log-normal NLL at the selected primary checkpoint",
    "cross_dataset_aggregation": false
  },
  "optimization": {
    "shared_across_all_datasets": true,
    "seed": 42,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "batch_size": 4096,
    "gradient_clip": 1.0,
    "epochs": 50,
    "minimum_epochs": 5,
    "early_stopping_patience": 8,
    "scheduler": null,
    "shuffle": "epoch-indexed CPU torch.Generator permutation",
    "dataset_specific_hyperparameters": false
  },
  "checkpoint_selection": {
    "candidate_epochs": "0 through last completed epoch",
    "monitor": "validation primary proper observation NLL",
    "rule": "earliest strict finite minimum",
    "fallback": "epoch 0",
    "epoch_zero": "all three paths exactly reproduce aligned-B",
    "secondary_metrics_in_selector": false,
    "resume": "module, AdamW, history, best state, immutable source/cache/context and observation contract restore exactly"
  },
  "identity_and_stability": {
    "canonical_dataset": "RMTPPWeekLookbackDataset",
    "cache_pairing": "cache row i pairs with canonical dataset sample i",
    "target_dt_bitwise_identity_required": true,
    "context_rule": "clear the appended final active target before the adapter; compact only earlier active durations in chronological order",
    "target_perturbation_invariance_required": true,
    "source_model_state_sha256_unchanged_required": true,
    "quantity_prediction_bitwise_identical_required": true,
    "time_median_bitwise_identical_required": true,
    "time_median_identity_source": "canonical aligned-B median tensor calculated on the requested runtime device",
    "cross_device_time_median_formula_absolute_tolerance": 1e-12,
    "cross_device_time_median_formula_relative_tolerance": 1e-12,
    "epoch_zero_continuous_and_interval_nll_exact_B_required": true,
    "finite_loss_gradient_model_optimizer_required": true,
    "calculation_dtype": "float64 likelihood; float32 GRU input/state",
    "same_device_pre_post_quantity_bitwise_identity_required": true,
    "cached_cross_device_quantity_comparison": "allclose provenance check only; not the preservation identity gate",
    "cross_device_quantity_absolute_tolerance": 1e-06,
    "cross_device_quantity_relative_tolerance": 1e-05
  },
  "execution_policy": {
    "order": [
      "local contract tests",
      "5080 full-data e1 on all three datasets",
      "Taxi seed42 full screening",
      "only after Taxi passes: Intermittent and Instacart seed42"
    ],
    "taxi_first_full_stop": true,
    "stop_after_taxi_failure": true,
    "additional_seed_policy": "not in this contract"
  },
  "acceptance": {
    "per_dataset_baseline_rule": "candidate primary NLL <= aligned-B minus the dataset minimum_candidate_primary_improvement",
    "aligned_A_rule": "candidate primary NLL <= aligned-A + 0.01 on every evaluated dataset",
    "history_attribution": "candidate primary NLL <= both global-scale and length-only controls by 0.005",
    "continuous_guardrail": "candidate continuous NLL <= aligned-B continuous NLL + 0.01",
    "quantity_guardrail": "aligned-B quantity predictions and metrics exactly preserved",
    "time_point_guardrail": "aligned-B time medians exactly preserved because location is frozen",
    "structured_gates": {
      "maximum_candidate_minus_aligned_A_primary_nll": 0.01,
      "minimum_candidate_improvement_over_each_control_primary_nll": 0.005,
      "maximum_candidate_minus_aligned_B_continuous_nll": 0.01,
      "require_quantity_prediction_bitwise_identity": true,
      "require_time_median_bitwise_identity": true,
      "require_base_location_bitwise_identity": true,
      "require_source_model_state_digest_identity": true
    }
  },
