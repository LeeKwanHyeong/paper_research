  "quantile_objective": {
    "statistics_split": "train only",
    "statistics_population": "exact next-event targets admitted by the canonical train loader; non-target first events are excluded",
    "quantiles": [0.5, 0.9, 0.95, 0.99],
    "interpolation": "nearest",
    "boundary_semantics": "equality remains in the lower bin",
    "bins": ["le_p50", "p50_p90", "p90_p95", "p95_p99", "gt_p99"],
    "raw_bin_weights": [1.0, 1.0, 1.5, 2.0, 3.0],
    "normalization": "divide every raw bin weight by its float64 arithmetic mean over the exact train-target population",
    "loss": "normalized_weight(target_quantity) * squared(softplus(quantity_preactivation) - log1p(target_quantity))",
    "reduction": "mean over target events; no per-batch renormalization",
    "strength": 1.0,
    "disabled_identity": "strength zero returns the original unweighted log-MSE directly for identical loss and gradients",
    "prohibited": [
      "validation-fitted quantiles or normalization",
      "held-out-fitted statistics",
      "dataset-specific manual weights",
      "dataset-specific lambda",
      "per-batch weight normalization",
      "post-outcome weight, boundary, or loss changes",
      "raw-quantity auxiliary loss",
      "new trainable parameters"
    ]
  },
  "checkpoint_selection": {
    "raw_monitor_history_key": "val_qty_rmse",
    "rule": "earliest strict finite minimum validation raw quantity RMSE",
    "early_stopping": "same monitor, minimum 40 epochs, patience 40",
    "other_metrics_in_selector": false,
    "time_body_tail_usage": "acceptance guardrails only",
