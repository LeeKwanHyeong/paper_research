  "cdf_transform": {
    "family": "conditional Kumaraswamy-generated distribution",
    "base_cdf_symbol": "u=F_B(t|h)",
    "cdf_formula": "F_C(t|h)=1-(1-u^a(h))^b(h)",
    "survival_formula": "S_C(t|h)=(1-u^a(h))^b(h)",
    "density_formula": "f_C(t|h)=a(h)b(h)u^(a(h)-1)(1-u^a(h))^(b(h)-1)f_B(t|h)",
    "shape_head": "Linear(64,2) with bias",
    "shape_head_weight_initialization": "exact zeros",
    "shape_head_bias_initialization": "exact zeros",
    "raw_shape_outputs": [
      "raw_a",
      "raw_b"
    ],
    "bounded_log_shape_formula": "log_shape=log(10)*tanh(raw_shape/log(10))",
    "shape_formula": "shape=exp(bounded_log_shape)",
    "minimum_shape": 0.1,
    "maximum_shape": 10.0,
    "expected_trainable_parameter_count": 130,
    "same_parameterization_for_every_dataset": true
  },
  "identity_contract": {
    "epoch_zero_shapes": "a(h)=b(h)=1 exactly for every finite hidden row",
    "epoch_zero_cdf": "F_C(t|h)=F_B(t|h) bitwise in float64",
    "epoch_zero_survival": "S_C(t|h)=S_B(t|h) bitwise in float64",
    "epoch_zero_density": "log f_C(t|h)=log f_B(t|h) bitwise in float64",
    "epoch_zero_positive_integer_mass": "all first-bin, regular-bin and top-code log probabilities equal aligned-B bitwise",
    "epoch_zero_base_quantile_level": "the requested calibrated quantile maps to the same base quantile level",
    "epoch_zero_quantity": "aligned-B quantity prediction tensor and all quantity metrics remain bitwise identical",
    "implementation": "add the difference between the transformed and numerically evaluated identity log probabilities to the caller-provided base log probability"
  },
