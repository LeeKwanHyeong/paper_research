{
  "contract_id": "hard_lmm_causal_duration_adapter_v1",
  "schema_version": 1,
  "candidate": {
    "name": "B_frozen_causal_log_duration_scale_adapter",
    "single_hypothesis": true,
    "purpose": "Recover duration-history-dependent uncertainty without changing the accepted B location, time median, encoder, memory, or quantity path",
    "source_contract_id": "hard_lmm_frozen_lognormal_duration_v1",
    "source_model": "selected proper Frozen-B seed42",
    "architecture": "single-layer causal GRU over active observed log1p durations followed by a zero-initialized scale-only projection",
    "backbone_change": false,
    "quantity_path_change": false,
    "location_change": false,
    "scale_only": true
  },
  "scope": {
    "input_splits": [
      "train",
      "validation"
    ],
    "optimization_split": "train",
    "selection_split": "validation",
    "evaluation_scope": "validation_only",
    "held_out_test": false,
    "additional_seeds": false,
    "quantity_predictions_may_change": false,
    "time_median_may_change": false
  },
  "frozen_source": {
    "checkpoint_type": "selected_frozen_lognormal_duration",
    "time_head_mode": "heteroscedastic_lognormal_duration",
    "all_model_parameters_trainable": false,
    "model_mode": "eval",
    "state_digest_must_remain_unchanged": true,
    "feature_cache": "reuse the exact full train and validation FrozenFeatureCache paired by canonical dataset index"
  },
  "adapter": {
    "class_name": "CausalLogDurationAdapter",
    "input_feature": "(log1p(observed_dt)-train_history_log1p_mean)/train_history_log1p_std",
    "input_source": "active context observed durations only",
    "appended_target_excluded": true,
    "marks_excluded": true,
    "quantities_excluded": true,
    "B_hidden_excluded": true,
    "recurrent_cell": "torch.nn.GRU",
    "input_size": 1,
    "hidden_size": 8,
    "num_layers": 1,
    "bidirectional": false,
    "dropout": 0.0,
    "output": "bounded_log_scale_residual",
    "output_projection_initialization": "exact zeros",
    "scale_formula": "sigma_candidate = sigma_B + (sigma_B - sigma_floor) * expm1(log(10) * tanh(raw_delta / log(10)))",
    "location_formula": "mu_candidate = mu_B exactly",
    "expected_trainable_parameter_count": 273,
    "maximum_scale_ratio": 10.0,
    "minimum_scale_ratio": 0.1,
    "max_absolute_log_scale_residual": 2.302585092994046,
    "sigma_floor": 0.001,
    "equivalent_scale_formula": "sigma_floor + (sigma_B - sigma_floor) * exp(bounded_log_scale_residual)"
  },
  "global_scale_control": {
    "role": "bias-only attribution control, not a second architecture candidate",
    "trainable_parameter_count": 1,
    "input_history": false,
    "initialization": "zero",
    "scale_formula": "sigma_control = sigma_B + (sigma_B - sigma_floor) * expm1(log(10) * tanh(raw_bias / log(10)))",
    "selection_and_optimizer": "identical to candidate",
    "minimum_scale_ratio": 0.1,
    "maximum_scale_ratio": 10.0,
    "sigma_floor": 0.001
  },
  "observation_likelihood": {
    "selection_metric": "continuous censor-aware normalized log-normal NLL in original time units",
    "uncensored_continuous": "-log f(dt | mu_B, sigma_adapted)",
    "instacart_continuous_top_code": "-log S(30 | mu_B, sigma_adapted)",
    "interval_telemetry": "centered interval-mass NLL, [max(0.5,dt-0.5),dt+0.5] for uncensored integer durations",
    "instacart_interval_top_code": "-log S(29.5 | mu_B, sigma_adapted)",
    "stable_interval_calculation": "float64 log-CDF/log-survival difference with log1mexp",
    "reduction": "arithmetic mean over admitted target events"
  },
  "optimization": {
    "shared_across_all_datasets": true,
    "seed": 42,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "batch_size": 4096,
    "gradient_clip": 1.0,
    "epochs": 50,
    "minimum_epochs": 5,
    "early_stopping_patience": 8,
    "scheduler": null,
    "shuffle": "epoch-indexed CPU torch.Generator permutation",
    "dataset_specific_hyperparameters": false
  },
  "checkpoint_selection": {
    "candidate_epochs": "0 through last completed epoch",
    "monitor": "validation_continuous_proper_time_nll",
    "rule": "earliest strict finite minimum",
    "fallback": "epoch 0",
    "epoch_zero": "zero scale projection exactly reproduces frozen B",
    "interval_nll_in_selector": false,
    "resume": "adapter/control model, AdamW, history, best state, and immutable source/cache/context identity restore exactly"
  },
  "identity_and_stability": {
    "canonical_dataset": "RMTPPWeekLookbackDataset",
    "cache_pairing": "cache row i pairs with canonical dataset sample i",
    "target_dt_bitwise_identity_required": true,
    "context_rule": "clear the appended final active target before the adapter; compact only earlier active durations in chronological order",
    "target_perturbation_invariance_required": true,
    "source_model_state_sha256_unchanged_required": true,
    "quantity_prediction_bitwise_identical_required": true,
    "time_median_bitwise_identical_required": true,
    "epoch_zero_continuous_and_interval_nll_exact_B_required": true,
    "finite_loss_gradient_model_optimizer_required": true,
    "calculation_dtype": "float64 likelihood; float32 GRU input/state",
    "same_device_pre_post_quantity_bitwise_identity_required": true,
    "cached_cross_device_quantity_comparison": "allclose provenance check only; not the preservation identity gate",
    "cross_device_quantity_absolute_tolerance": 1e-06,
    "cross_device_quantity_relative_tolerance": 1e-05
  },
  "execution_policy": {
    "order": [
      "local contract tests",
      "5090 CUDA e1 on Taxi",
      "Taxi seed42 full screening",
      "only after Taxi passes: Intermittent and Instacart seed42"
    ],
    "taxi_first_stop": true,
    "stop_after_taxi_failure": true,
    "additional_seed_policy": "stopped; no seeds 52 or 62"
  },
  "acceptance": {
    "candidate_continuous_nll_vs_B": "candidate <= frozen B on every evaluated dataset",
    "candidate_continuous_nll_vs_A": "candidate <= A + 0.01 on every evaluated dataset",
    "candidate_interval_nll_vs_B": "candidate <= frozen B on every evaluated dataset",
    "history_attribution": "candidate continuous NLL <= global-scale control continuous NLL - 0.005",
    "quantity_guardrail": "all B quantity predictions and metrics exactly preserved",
    "time_point_guardrail": "all B validation time medians and median-error metrics exactly preserved",
    "legacy_nll_comparison_prohibited": true,
    "cross_dataset_nll_aggregation_prohibited": true,
    "structured_gates": {
      "maximum_candidate_minus_B_continuous_nll": 0.0,
      "maximum_candidate_minus_A_continuous_nll": 0.01,
      "require_candidate_interval_nll_nonworse_than_B": true,
