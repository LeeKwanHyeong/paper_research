  "sources": [
    {
      "id": "component_metrics_sql",
      "label": "LPHC 구성요소 fold·history 지표 추출",
      "path": "paper/results/hard_lmm_level_history_qkv_component_diagnostic_20260909/component_metrics.sql",
      "query": {
        "engine": "sqlite",
        "language": "sql",
        "sql": "SELECT\n  model || ' · F' || substr(scope, 6, 1) AS variant_fold,\n  model AS variant,\n  CAST(substr(scope, 6, 1) AS INTEGER) AS fold,\n  CASE history WHEN '2-3' THEN 'H2–3' WHEN '8-15' THEN 'H8–15' END AS history_slice,\n  CASE history WHEN '2-3' THEN 0 ELSE 1 END AS history_order,\n  CAST(count AS INTEGER) AS target_count,\n  CAST(mae AS REAL) AS mae,\n  CAST(mse AS REAL) AS mse,\n  CAST(rmse AS REAL) AS rmse,\n  CAST(bias AS REAL) AS bias,\n  CAST(centered_mse AS REAL) AS centered_mse,\n  CAST(delta_mse_vs_B AS REAL) AS delta_mse_vs_B,\n  CAST(delta_mse_vs_residual_off AS REAL) AS delta_mse_vs_residual_off\nFROM history_metrics\nWHERE model IN ('residual_off', 'q_only', 'k_only', 'v_only', 'full_qkv')\n  AND scope IN ('fold_0', 'fold_1')\n  AND history IN ('2-3', '8-15')\nORDER BY\n  CASE model\n    WHEN 'residual_off' THEN 0\n    WHEN 'q_only' THEN 1\n    WHEN 'k_only' THEN 2\n    WHEN 'v_only' THEN 3\n    ELSE 4\n  END,\n  fold,\n  history_order;",
        "description": "검토된 history_metrics.csv에서 두 fold의 H2–3 및 H8–15 비교 행을 추출합니다.",
        "tables_used": [
          "history_metrics"
        ],
        "filters": {
          "models": [
            "residual_off",
            "q_only",
            "k_only",
            "v_only",
            "full_qkv"
          ],
          "folds": [
            0,
            1
          ],
          "history_slices": [
            "2-3",
            "8-15"
          ]
        },
